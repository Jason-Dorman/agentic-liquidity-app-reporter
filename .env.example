# Copy to .env and fill in. .env is gitignored and never committed.
# The real environment wins over this file. A blank value counts as not set.

# Anthropic
ANTHROPIC_API_KEY=

# Blockford app API, reached through the SSM port-forward (app RUNBOOK section 2b).
# Local port is 3300, not 3000. 3000 is the local dev stack; 3300 is the tunnel to prod.
# Keep the /corridor-scout prefix; a bare /api/... returns 404.
BLOCKFORD_API_BASE_URL=http://localhost:3300/corridor-scout/api

# Agent. The three numbers are whole numbers of 1 or more.
MODEL=claude-sonnet-5-5
MAX_TOOL_CALLS=15
MAX_OUTPUT_TOKENS=16000
HISTORY_DAYS=7
